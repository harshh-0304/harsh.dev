---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import { getCollection } from "astro:content";
import { site } from "@/config/site";

export async function getStaticPaths() {
  const projects = await getCollection("projects");
  return projects.map((project) => ({
    params: { id: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const { data } = project;
---

<Layout
  title={`${data.title} — ${site.name}`}
  description={data.description}
>
  <Header />

  <main class="pt-28 pb-20">
    <div class="mx-auto max-w-4xl px-6">
      <!-- Back Link -->
      <a
        href="/#projects"
        class="inline-flex items-center gap-1.5 text-sm text-text-tertiary hover:text-text-primary transition-colors mb-8"
      >
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
        Back to projects
      </a>

      <!-- Header Section -->
      <div class="mb-10">
        <div class="flex flex-wrap items-center gap-2 mb-4">
          <span class="text-xs font-semibold text-amber-800 bg-amber-50 border border-amber-200/60 rounded-full px-3 py-0.5">
            {data.professional ? "Production Client Project" : "Open Source & Systems"}
          </span>
          <span class={`text-xs font-semibold rounded-full px-3 py-0.5 border ${
            data.status === "Live"
              ? "text-emerald-800 bg-emerald-50 border-emerald-200/60"
              : data.status === "Completed"
                ? "text-blue-800 bg-blue-50 border-blue-200/60"
                : "text-text-secondary bg-gray-100 border-gray-200"
          }`}>
            {data.status}
          </span>
          <span class="text-xs font-medium text-text-tertiary bg-gray-50 border border-border/80 rounded-full px-3 py-0.5">
            {data.category}
          </span>
        </div>

        <h1 class="text-3xl sm:text-5xl font-black tracking-tight text-text-primary font-display mb-4">
          {data.title}
        </h1>

        <p class="text-lg text-text-secondary leading-relaxed max-w-3xl">
          {data.description}
        </p>

        <!-- CTA Buttons Strip -->
        <div class="flex flex-wrap gap-3 mt-6">
          {data.url && (
            <a
              href={data.url}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 text-sm font-semibold rounded-full bg-slate-900 text-white px-6 py-2.5 shadow-sm hover:bg-black transition-all"
            >
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 3h6v6"/><path d="M10 14 21 3"/><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/></svg>
              Live Product
            </a>
          )}
          {data.github && (
            <a
              href={data.github}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 text-sm font-semibold rounded-full border border-border bg-white text-text-primary px-6 py-2.5 hover:border-slate-900 transition-all"
            >
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"/><path d="M9 18c-4.51 2-5-2-7-2"/></svg>
              Source Code
            </a>
          )}
          {data.buttons?.map((btn) =>
            btn.url && btn.url !== data.url ? (
              <a
                key={btn.label}
                href={btn.url}
                target={btn.url.startsWith("http") ? "_blank" : "_self"}
                rel={btn.url.startsWith("http") ? "noopener noreferrer" : ""}
                class="inline-flex items-center gap-2 text-sm font-semibold rounded-full border border-border bg-white text-text-secondary hover:text-text-primary px-5 py-2.5 transition-all"
              >
                {btn.label} &rarr;
              </a>
            ) : null
          )}
        </div>
      </div>

      <!-- Problem & Solution Cards (If Available) -->
      {(data.problem || data.solution) && (
        <div class="grid sm:grid-cols-2 gap-6 mb-12">
          {data.problem && (
            <div class="p-6 rounded-2xl bg-surface-alt border border-border/80">
              <h2 class="text-xs font-bold uppercase tracking-widest text-text-tertiary mb-2">The Challenge</h2>
              <p class="text-sm text-text-secondary leading-relaxed">{data.problem}</p>
            </div>
          )}
          {data.solution && (
            <div class="p-6 rounded-2xl bg-surface-alt border border-border/80">
              <h2 class="text-xs font-bold uppercase tracking-widest text-text-tertiary mb-2">Engineering Solution</h2>
              <p class="text-sm text-text-secondary leading-relaxed">{data.solution}</p>
            </div>
          )}
        </div>
      )}

      <!-- Tech Stack -->
      {data.tech.length > 0 && (
        <div class="mb-10 pb-8 border-b border-border">
          <h2 class="text-xs font-bold text-text-tertiary mb-3 uppercase tracking-widest">Technologies Used</h2>
          <div class="flex flex-wrap gap-2">
            {data.tech.map((t: string) => (
              <span key={t} class="text-xs font-semibold text-text-primary bg-surface-alt border border-border rounded-lg px-3 py-1.5 shadow-2xs">
                {t}
              </span>
            ))}
          </div>
        </div>
      )}

      <!-- Key Features from Markdown Body -->
      {project.rendered?.html && (
        <div class="mb-12">
          <h2 class="text-xs font-bold text-text-tertiary mb-4 uppercase tracking-widest">Key Deliverables & Architecture</h2>
          <div class="text-text-secondary text-sm leading-relaxed [&_li]:mb-2.5 [&_ul]:list-disc [&_ul]:pl-5 [&_strong]:text-text-primary [&_strong]:font-semibold">
            <Fragment set:html={project.rendered.html} />
          </div>
        </div>
      )}

      <!-- Screenshots Gallery -->
      {data.screenshots && data.screenshots.length > 0 && (
        <div class="pt-8 border-t border-border">
          <h2 class="text-xs font-bold text-text-tertiary mb-6 uppercase tracking-widest">Visual Overview</h2>
          <div class={`grid gap-4 ${
            data.category === "iOS Mobile Application"
              ? "grid-cols-2 sm:grid-cols-3 lg:grid-cols-4"
              : "grid-cols-1 sm:grid-cols-2"
          }`}>
            {data.screenshots.map((src: string, i: number) => (
              <div key={src} class={`rounded-xl border border-border overflow-hidden bg-gray-50 shadow-sm ${
                data.category === "iOS Mobile Application" ? "" : "aspect-[16/10]"
              }`}>
                <img
                  src={src}
                  alt={`${data.title} screenshot ${i + 1}`}
                  class={`w-full h-full ${
                    data.category === "iOS Mobile Application"
                      ? "object-contain"
                      : "object-cover object-top"
                  }`}
                  loading="lazy"
                  width="800"
                  height="500"
                />
              </div>
            ))}
          </div>
        </div>
      )}
    </div>
  </main>

  <Footer />
</Layout>
