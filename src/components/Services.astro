---
import { services } from "@/config/site";
---

<section id="services" class="py-24 lg:py-32 bg-surface border-t border-border">
  <div class="mx-auto max-w-7xl px-6 sm:px-8 lg:px-12">
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-16">
      <div>
        <p class="text-xs font-semibold uppercase tracking-widest text-text-tertiary mb-3" data-reveal="fade-up">
          Capabilities
        </p>
        <h2 class="text-4xl sm:text-5xl font-extrabold tracking-tight text-text-primary uppercase" data-reveal="fade-up" data-reveal-delay="100">
          Services & Expertise
        </h2>
      </div>
      <p class="text-sm text-text-secondary max-w-sm" data-reveal="fade-up" data-reveal-delay="200">
        From initial concept to deployment — scalable architecture built for growth.
      </p>
    </div>

    <!-- 3 Core Capabilities Editorial Row -->
    <div class="grid lg:grid-cols-3 gap-8 lg:gap-12 divide-y lg:divide-y-0 lg:divide-x divide-border pt-4">
      {services.map((service, idx) => (
        <div key={service.title} class={`pt-8 lg:pt-0 ${idx !== 0 ? "lg:pl-10" : ""}`} data-reveal="fade-up" data-reveal-delay={idx * 150}>
          <span class="text-3xl font-extrabold text-brand tracking-tighter block mb-4">
            {service.number}
          </span>
          <h3 class="text-2xl font-bold text-text-primary mb-3">
            {service.title}
          </h3>
          <p class="text-sm text-text-secondary leading-relaxed">
            {service.description}
          </p>
        </div>
      ))}
    </div>
  </div>
</section>
