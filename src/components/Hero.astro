---
import { site } from "@/config/site";

const coreTech = [
  "TypeScript",
  "Next.js 16",
  "Python",
  "Cloudflare Workers",
  "PostgreSQL",
  "Docker",
  "Django",
  "React",
];

const metrics = [
  { value: "10,000+", label: "Firms Indexed", note: "FirmsLedger Platform" },
  { value: "1,200+", label: "Games Synced", note: "Real-time provider APIs" },
  { value: "1.5+ Yrs", label: "Production", note: "Full-Stack & Backend" },
];
---

<section id="hero-section" class="pt-28 pb-16 lg:pt-36 lg:pb-24 hero-gradient relative overflow-hidden">
  <div class="mx-auto max-w-7xl px-6 sm:px-8 lg:px-12">
    <div class="grid lg:grid-cols-12 gap-10 lg:gap-12 items-center">
      
      <!-- Left Column: Editorial Headline & Value Proposition (7 cols) -->
      <div class="lg:col-span-7 flex flex-col justify-center" data-reveal="fade-up">
        
        <!-- Live Status Pill -->
        <div class="inline-flex items-center gap-2 rounded-full border border-emerald-300/80 bg-emerald-50/80 px-3.5 py-1 text-xs font-semibold text-emerald-900 shadow-2xs mb-6 w-fit">
          <span class="relative flex h-2 w-2">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-500 opacity-75"></span>
            <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-600"></span>
          </span>
          <span>Software Engineer · Backend & Full-Stack</span>
          <span class="text-emerald-300">·</span>
          <span class="text-emerald-800 font-normal">{site.location}</span>
        </div>

        <!-- Main Commanding Typographic Headline -->
        <h1 class="text-4xl sm:text-5xl lg:text-[3.5rem] xl:text-[3.75rem] font-black text-slate-900 tracking-tight font-display leading-[1.08] break-normal hyphens-none mb-6">
          Building high-throughput backends & modern digital products.
        </h1>

        <!-- Direct Technical Value Proposition -->
        <p class="text-base sm:text-lg text-slate-600 leading-relaxed max-w-xl mb-8">
          I'm <strong class="text-slate-900 font-semibold">{site.name}</strong>, a Software Engineer specializing in scalable API architectures, high-concurrency backend services, and modern digital platforms. Proven track record architecting <strong class="text-slate-900 font-semibold">FirmsLedger</strong> (10,000+ US manufacturers directory) and backend infrastructure integrating <strong class="text-slate-900 font-semibold">1,200+ games</strong>.
        </p>

        <!-- Action Callouts (Work, Resume, Contact) -->
        <div class="flex flex-wrap items-center gap-3.5 mb-10">
          <a
            href="#projects"
            class="inline-flex items-center gap-2 rounded-full bg-slate-900 px-7 py-3.5 text-xs font-bold uppercase tracking-wider text-white shadow-md hover:bg-black hover:shadow-lg hover:-translate-y-0.5 active:translate-y-0 transition-all duration-200"
          >
            Selected Work &rarr;
          </a>
          {site.resumeUrl && (
            <a
              href={site.resumeUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 rounded-full border border-slate-300 bg-white px-6 py-3.5 text-xs font-bold uppercase tracking-wider text-slate-800 shadow-2xs hover:border-slate-900 hover:text-slate-950 hover:-translate-y-0.5 active:translate-y-0 transition-all duration-200"
            >
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                <polyline points="7 10 12 15 17 10"></polyline>
                <line x1="12" y1="15" x2="12" y2="3"></line>
              </svg>
              Resume / CV
            </a>
          )}
          <a
            href="#contact"
            class="inline-flex items-center gap-1.5 px-4 py-3.5 text-xs font-bold uppercase tracking-wider text-slate-600 hover:text-slate-950 transition-colors"
          >
            Let's Talk &rarr;
          </a>
        </div>

        <!-- Core Stack Badges Strip -->
        <div class="pt-6 border-t border-slate-200/90">
          <p class="text-[11px] font-bold uppercase tracking-widest text-slate-400 mb-3">
            Core Production Stack
          </p>
          <div class="flex flex-wrap gap-2">
            {coreTech.map((tech) => (
              <span
                key={tech}
                class="px-3 py-1.5 rounded-lg text-xs font-semibold text-slate-700 bg-white border border-slate-200/90 shadow-2xs hover:border-slate-900 transition-colors cursor-default"
              >
                {tech}
              </span>
            ))}
          </div>
        </div>

      </div>

      <!-- Right Column: Engineering Console Card (5 cols) -->
      <div class="lg:col-span-5" data-reveal="fade-up" data-reveal-delay="150">
        <div class="rounded-3xl bg-slate-950 text-white shadow-2xl border border-slate-800/80 p-6 sm:p-7 relative overflow-hidden">
          
          <!-- Subtle Ambient Radial Glows -->
          <div class="absolute -top-20 -right-20 w-52 h-52 bg-blue-500/10 rounded-full blur-3xl pointer-events-none"></div>
          <div class="absolute -bottom-20 -left-20 w-52 h-52 bg-emerald-500/10 rounded-full blur-3xl pointer-events-none"></div>

          <!-- Console Header Bar -->
          <div class="flex items-center justify-between pb-5 border-b border-slate-800/80 relative">
            <div class="flex items-center gap-1.5">
              <span class="w-2.5 h-2.5 rounded-full bg-rose-500/80"></span>
              <span class="w-2.5 h-2.5 rounded-full bg-amber-500/80"></span>
              <span class="w-2.5 h-2.5 rounded-full bg-emerald-500/80"></span>
              <span class="ml-2 font-mono text-[11px] text-slate-400">~/harsh.dev</span>
            </div>
            <span class="font-mono text-[10px] text-emerald-400 uppercase tracking-widest flex items-center gap-1.5">
              <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
              active · {site.location}
            </span>
          </div>

          <!-- Profile Snapshot -->
          <div class="flex items-center gap-4 py-5 border-b border-slate-800/80 relative">
            <div class="relative w-16 h-16 rounded-2xl overflow-hidden border border-slate-700 shadow-md shrink-0 ring-2 ring-slate-800">
              <img
                src={site.avatar}
                alt={site.name}
                width="64"
                height="64"
                class="w-full h-full object-cover"
              />
            </div>
            <div>
              <h2 class="text-xl font-black text-white font-display tracking-tight">{site.name}</h2>
              <p class="text-xs font-semibold text-slate-300 mt-0.5">Software Engineer</p>
              <p class="text-[11px] text-slate-400 font-mono mt-0.5">Backend & Full-Stack Systems</p>
            </div>
          </div>

          <!-- High-Contrast Metric Numbers Grid -->
          <div class="grid grid-cols-3 gap-2.5 my-5 relative">
            {metrics.map((m) => (
              <div key={m.label} class="p-3 rounded-2xl bg-slate-900/90 border border-slate-800/80 text-center">
                <span class="text-2xl font-black text-white font-display block">
                  {m.value}
                </span>
                <span class="text-[10px] font-bold uppercase tracking-wider text-slate-400 block mt-0.5">
                  {m.label}
                </span>
              </div>
            ))}
          </div>

          <!-- Engineering Specs Monospace Rows -->
          <div class="space-y-2.5 py-4 border-t border-slate-800/80 text-xs font-mono relative">
            <div class="flex items-center justify-between text-slate-300">
              <span class="text-slate-500 text-[11px] uppercase tracking-wider">Role</span>
              <span class="text-white font-medium">Software Engineer</span>
            </div>
            <div class="flex items-center justify-between text-slate-300">
              <span class="text-slate-500 text-[11px] uppercase tracking-wider">Focus</span>
              <span class="text-slate-200">High-Concurrency APIs & Distributed Systems</span>
            </div>
            <div class="flex items-center justify-between text-slate-300">
              <span class="text-slate-500 text-[11px] uppercase tracking-wider">Flagship</span>
              <span class="text-slate-200">FirmsLedger · iGaming Platform · VoiceDesk</span>
            </div>
          </div>

          <!-- Console Footer: Socials & Link -->
          <div class="pt-4 border-t border-slate-800/80 flex items-center justify-between relative">
            <div class="flex items-center gap-3">
              <a
                href={site.github}
                target="_blank"
                rel="noopener noreferrer"
                class="text-slate-400 hover:text-white transition-colors p-1"
                title="GitHub"
              >
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"></path>
                  <path d="M9 18c-4.51 2-5-2-7-2"></path>
                </svg>
              </a>
              <a
                href={site.linkedin}
                target="_blank"
                rel="noopener noreferrer"
                class="text-slate-400 hover:text-white transition-colors p-1"
                title="LinkedIn"
              >
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"></path>
                  <rect width="4" height="12" x="2" y="9"></rect>
                  <circle cx="4" cy="4" r="2"></circle>
                </svg>
              </a>
              <a
                href={`mailto:${site.email}`}
                class="text-slate-400 hover:text-white transition-colors p-1"
                title="Email"
              >
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <rect width="20" height="16" x="2" y="4" rx="2"></rect>
                  <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
                </svg>
              </a>
            </div>
            <a href="#about" class="text-xs font-semibold text-emerald-400 hover:text-emerald-300 transition-colors inline-flex items-center gap-1 font-mono">
              profile details &rarr;
            </a>
          </div>

        </div>
      </div>

    </div>
  </div>
</section>
