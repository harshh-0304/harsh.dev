---
import { site } from "@/config/site";
const nameChars = site.name.toUpperCase().split("");
---

<section class="relative min-h-screen flex flex-col justify-between pt-28 pb-8 hero-gradient overflow-hidden">
  <div class="mx-auto max-w-7xl px-6 sm:px-8 lg:px-12 w-full my-auto">
    <!-- Quiet Role / Location Tag -->
    <div id="hero-meta" class="mb-8">
      <p class="text-xs font-bold uppercase tracking-widest text-text-tertiary">
        Software Engineer <span class="mx-2">·</span> Based in India
      </p>
    </div>

    <!-- Main Editorial Display Name & Headline -->
    <div id="hero-heading" class="overflow-hidden mb-6">
      <h1 class="text-5xl sm:text-7xl lg:text-[6.5rem] font-black tracking-tight leading-[0.92] text-text-primary uppercase flex flex-wrap gap-x-3 sm:gap-x-5 font-display">
        {nameChars.map((char, index) => (
          <span id="hero-title-char" class="inline-block" key={index}>
            {char === " " ? "\u00A0" : char}
          </span>
        ))}
      </h1>
      <p id="hero-subheading" class="text-xl sm:text-2xl lg:text-3xl font-medium text-text-secondary mt-5 tracking-tight">
        Software Engineer <span class="text-text-tertiary">·</span> I design and build digital products.
      </p>
    </div>

    <!-- Simplified Non-Technical Description & Action CTAs -->
    <div id="hero-meta-body" class="max-w-2xl mt-8">
      <p class="text-base sm:text-lg text-text-secondary leading-relaxed mb-10">
        I design and build digital products, from modern web applications to the systems that power them.
      </p>

      <div class="flex flex-wrap items-center gap-4">
        <a
          href="#projects"
          class="inline-flex items-center gap-2 rounded-full bg-text-primary px-7 py-3.5 text-sm font-semibold text-white shadow-md hover:bg-black hover:-translate-y-0.5 transition-all duration-300"
        >
          Selected Work &rarr;
        </a>
        <a
          href="#contact"
          class="inline-flex items-center gap-2 rounded-full border border-text-primary bg-white px-7 py-3.5 text-sm font-semibold text-text-primary hover:bg-surface-alt hover:-translate-y-0.5 transition-all duration-300"
        >
          Get in touch
        </a>
        <a
          href={site.resumeUrl}
          download="Harsh_Jadav_Resume.pdf"
          class="inline-flex items-center gap-2 rounded-full px-5 py-3 text-xs font-semibold uppercase tracking-wider text-text-tertiary hover:text-text-primary transition-colors"
        >
          Resume
        </a>
      </div>
    </div>
  </div>

  <!-- Quieter Integrated Stats & Tease Indicator -->
  <div class="mx-auto max-w-7xl px-6 sm:px-8 lg:px-12 w-full pt-10 border-t border-border">
    <div class="grid grid-cols-3 gap-6 sm:gap-12">
      <div>
        <span class="text-xl sm:text-2xl font-black text-text-primary font-display block tracking-tight">01+</span>
        <span class="text-xs text-text-tertiary font-medium">Years building production software</span>
      </div>
      <div>
        <span class="text-xl sm:text-2xl font-black text-text-primary font-display block tracking-tight">11+</span>
        <span class="text-xs text-text-tertiary font-medium">Projects shipped</span>
      </div>
      <div>
        <span class="text-xl sm:text-2xl font-black text-text-primary font-display block tracking-tight">1,200+</span>
        <span class="text-xs text-text-tertiary font-medium">Games integrated</span>
      </div>
    </div>
  </div>
</section>
