---
import { site } from "@/config/site";
---

<section class="relative min-h-screen flex items-center pt-20 pb-16 hero-gradient overflow-hidden">
  <!-- Decorative shapes -->
  <div class="absolute top-20 right-[10%] w-72 h-72 bg-brand/[0.03] rounded-full blur-3xl"></div>
  <div class="absolute bottom-20 left-[5%] w-96 h-96 bg-brand/[0.02] rounded-full blur-3xl"></div>

  <div class="mx-auto max-w-6xl px-6 w-full relative">
    <div class="grid lg:grid-cols-2 gap-12 lg:gap-16 items-center">
      <!-- Left: Content -->
      <div class="order-2 lg:order-1">
        <!-- Availability Badge -->
        <div class="fade-up inline-flex items-center gap-2 rounded-full border border-emerald-200 bg-emerald-50 px-3.5 py-1.5 mb-8">
          <span class="relative flex h-2 w-2">
            <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-emerald-400 opacity-75"></span>
            <span class="relative inline-flex h-2 w-2 rounded-full bg-emerald-500"></span>
          </span>
          <span class="text-sm text-emerald-700 font-medium">{site.availability}</span>
        </div>

        <!-- Heading -->
        <h1 class="fade-up text-4xl sm:text-5xl lg:text-[3.5rem] font-bold tracking-tight leading-[1.08] text-text-primary mb-6">
          I build backends<br />
          <span class="bg-gradient-to-r from-brand to-brand-light bg-clip-text text-transparent">that scale.</span>
        </h1>

        <!-- Tabs Switcher -->
        <div class="fade-up inline-flex items-center gap-1 rounded-xl border-2 border-text-primary bg-surface-alt p-1 shadow-[3px_3px_0px_0px_rgba(15,23,42,1)] mb-8">
          <button
            id="tab-firmsledger"
            class="px-4 py-2 text-sm font-bold rounded-lg border-2 border-text-primary bg-brand text-white shadow-[2px_2px_0px_0px_rgba(15,23,42,1)] transition-all duration-200 cursor-pointer"
          >
            FirmsLedger
          </button>
          <button
            id="tab-betorra"
            class="px-4 py-2 text-sm font-semibold rounded-lg border-2 border-transparent text-text-secondary hover:text-text-primary transition-all duration-200 cursor-pointer"
          >
            Betorra
          </button>
        </div>

        <!-- Description -->
        <div id="content-firmsledger">
          <p class="fade-up text-lg text-text-secondary leading-relaxed max-w-xl mb-10">
            Backend Engineer shipping production systems — scalable REST APIs,
            real-time transaction processing, and multi-provider integrations.
            Currently building <strong class="text-text-primary font-semibold">FirmsLedger</strong>.
          </p>
        </div>
        <div id="content-betorra" class="hidden">
          <p class="text-lg text-text-secondary leading-relaxed max-w-xl mb-10">
            Backend Engineer shipping production systems — scalable REST APIs,
            real-time transaction processing, and multi-provider integrations.
            Architected the backend for <strong class="text-text-primary font-semibold">Betorra</strong>.
          </p>
        </div>

        <!-- Stats -->
        <div class="fade-up flex flex-wrap gap-x-6 gap-y-4 sm:gap-x-8 items-center mb-10">
          <div>
            <div class="text-3xl font-bold text-text-primary">1+</div>
            <div class="text-sm text-text-tertiary mt-0.5">Years Experience</div>
          </div>
          <div class="w-px h-8 bg-border hidden sm:block"></div>
          <div>
            <div class="text-3xl font-bold text-text-primary">11+</div>
            <div class="text-sm text-text-tertiary mt-0.5">Projects Shipped</div>
          </div>
          <div class="w-px h-8 bg-border hidden sm:block"></div>
          <div id="stat-firmsledger">
            <div class="text-3xl font-bold text-text-primary">5,000+</div>
            <div class="text-sm text-text-tertiary mt-0.5">Verified Manufacturers</div>
          </div>
          <div id="stat-betorra" class="hidden">
            <div class="text-3xl font-bold text-text-primary">1,200+</div>
            <div class="text-sm text-text-tertiary mt-0.5">Games Integrated</div>
          </div>
        </div>

        <!-- CTAs -->
        <div class="fade-up flex flex-wrap gap-4">
          <a
            href="#projects"
            class="neo-btn inline-flex items-center gap-2 rounded-xl bg-brand px-6 py-3 text-base font-medium text-white transition-all duration-200"
          >
            View my work
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
          </a>
          <a
            href="#contact"
            class="neo-btn inline-flex items-center gap-2 rounded-xl bg-white px-6 py-3 text-base font-medium text-text-primary transition-all duration-200"
          >
            Get in touch
          </a>
          <a
            href={site.resumeUrl}
            download="Harsh_Jadav_Resume.pdf"
            class="neo-btn inline-flex items-center gap-2 rounded-xl bg-white px-6 py-3 text-base font-medium text-text-secondary hover:text-text-primary transition-all duration-200"
          >
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
            Resume
          </a>
        </div>
      </div>

      <!-- Right: Photo -->
      <div class="order-1 lg:order-2 flex justify-center lg:justify-end">
        <div class="fade-up relative">
          <div class="w-64 h-64 sm:w-80 sm:h-80 rounded-3xl overflow-hidden border border-border shadow-2xl shadow-gray-200/50 ring-1 ring-black/[0.02]">
            <img
              src={site.avatar}
              alt={site.name}
              width="320"
              height="320"
              class="w-full h-full object-cover"
              loading="eager"
            />
          </div>
          <!-- Decorative elements -->
          <div class="absolute -z-10 -top-4 -right-4 w-full h-full rounded-3xl bg-brand/5 border border-brand/10"></div>
          <div class="absolute -z-20 -top-8 -right-8 w-full h-full rounded-3xl bg-brand/[0.02] border border-brand/5"></div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  const tabFirmsledger = document.getElementById('tab-firmsledger');
  const tabBetorra = document.getElementById('tab-betorra');
  const contentFirmsledger = document.getElementById('content-firmsledger');
  const contentBetorra = document.getElementById('content-betorra');
  const statFirmsledger = document.getElementById('stat-firmsledger');
  const statBetorra = document.getElementById('stat-betorra');

  function switchTab(activeTab: 'firmsledger' | 'betorra') {
    if (activeTab === 'firmsledger') {
      tabFirmsledger?.classList.add('bg-brand', 'text-white', 'border-text-primary', 'shadow-[2px_2px_0px_0px_rgba(15,23,42,1)]', 'font-bold');
      tabFirmsledger?.classList.remove('border-transparent', 'text-text-secondary', 'font-semibold');
      
      tabBetorra?.classList.add('border-transparent', 'text-text-secondary', 'font-semibold');
      tabBetorra?.classList.remove('bg-brand', 'text-white', 'border-text-primary', 'shadow-[2px_2px_0px_0px_rgba(15,23,42,1)]', 'font-bold');

      contentFirmsledger?.classList.remove('hidden');
      contentBetorra?.classList.add('hidden');

      statFirmsledger?.classList.remove('hidden');
      statBetorra?.classList.add('hidden');
    } else {
      tabBetorra?.classList.add('bg-brand', 'text-white', 'border-text-primary', 'shadow-[2px_2px_0px_0px_rgba(15,23,42,1)]', 'font-bold');
      tabBetorra?.classList.remove('border-transparent', 'text-text-secondary', 'font-semibold');

      tabFirmsledger?.classList.add('border-transparent', 'text-text-secondary', 'font-semibold');
      tabFirmsledger?.classList.remove('bg-brand', 'text-white', 'border-text-primary', 'shadow-[2px_2px_0px_0px_rgba(15,23,42,1)]', 'font-bold');

      contentBetorra?.classList.remove('hidden');
      contentFirmsledger?.classList.add('hidden');

      statBetorra?.classList.remove('hidden');
      statFirmsledger?.classList.add('hidden');
    }
  }

  tabFirmsledger?.addEventListener('click', () => switchTab('firmsledger'));
  tabBetorra?.addEventListener('click', () => switchTab('betorra'));
</script>
