---
import { site } from "@/config/site";
---

<section id="hero-section" class="relative min-h-screen flex flex-col justify-between pt-28 pb-8 hero-gradient overflow-hidden">
  <!-- Subtle ambient background shapes -->
  <div class="absolute top-1/4 left-10 w-96 h-96 bg-slate-900/[0.02] rounded-full blur-3xl pointer-events-none"></div>
  <div class="absolute bottom-20 right-10 w-96 h-96 bg-slate-900/[0.03] rounded-full blur-3xl pointer-events-none"></div>

  <div class="mx-auto max-w-7xl px-6 sm:px-8 lg:px-12 w-full my-auto relative z-10">
    <div class="grid lg:grid-cols-12 gap-12 lg:gap-8 items-center">

      <!-- Left Column: Refined Typography & Bio (7 cols) -->
      <div class="lg:col-span-7 space-y-6">
        <!-- Friendly Pill Badge -->
        <div id="hero-meta">
          <div class="inline-flex items-center gap-2 rounded-full border border-emerald-200 bg-emerald-50 px-3.5 py-1 text-xs font-semibold text-emerald-800">
            <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
            <span>Hey, I'm Harsh</span>
          </div>
        </div>

        <!-- Static Headline (No Font Entrance Animation) -->
        <div id="hero-heading">
          <h1 class="text-4xl sm:text-6xl lg:text-[4.75rem] font-black tracking-tight leading-[0.96] text-text-primary uppercase font-display">
            Harsh Jadav
          </h1>
          <p id="hero-subheading" class="text-xl sm:text-2xl font-bold text-text-secondary mt-4 tracking-tight font-display">
            Software Engineer <span class="text-text-tertiary">·</span> I design & build digital products.
          </p>
        </div>

        <!-- Description -->
        <p id="hero-meta-body" class="text-base sm:text-lg text-text-secondary leading-relaxed max-w-xl">
          Software Engineer specializing in scalable backend systems, high-concurrency platforms, and full-stack web applications.
        </p>

        <!-- Brands / Products Row -->
        <div class="pt-2">
          <p class="text-[11px] font-bold uppercase tracking-widest text-text-tertiary mb-2">Systems & Products Built</p>
          <div class="flex flex-wrap items-center gap-x-6 gap-y-2 text-xs font-bold text-text-secondary font-display">
            <span>BETORRA</span>
            <span class="text-text-tertiary">·</span>
            <span>FIRMSLEDGER</span>
            <span class="text-text-tertiary">·</span>
            <span>DUBFLIX</span>
            <span class="text-text-tertiary">·</span>
            <span>HMD</span>
            <span class="text-text-tertiary">·</span>
            <span>CYBER7</span>
          </div>
        </div>

        <!-- CTAs -->
        <div class="flex flex-wrap items-center gap-4 pt-2">
          <a
            href="#projects"
            class="inline-flex items-center gap-2 rounded-full bg-text-primary px-7 py-3.5 text-sm font-semibold text-white shadow-md hover:bg-black hover:-translate-y-0.5 transition-all duration-300"
          >
            Selected Work &rarr;
          </a>
          <a
            href="#contact"
            class="inline-flex items-center gap-2 rounded-full border border-text-primary bg-white px-7 py-3.5 text-sm font-semibold text-text-primary hover:bg-surface-alt hover:-translate-y-0.5 transition-all duration-300"
          >
            Get in touch
          </a>
          <a
            href={site.resumeUrl}
            download="Harsh_Jadav_Resume.pdf"
            class="inline-flex items-center gap-2 rounded-full px-5 py-3 text-xs font-semibold uppercase tracking-wider text-text-tertiary hover:text-text-primary transition-colors"
          >
            Resume
          </a>
        </div>
      </div>

      <!-- Right Column: Interactive Floating Work Showcase Canvas (5 cols) -->
      <div class="lg:col-span-5 relative min-h-[380px] sm:min-h-[440px] flex items-center justify-center">
        <!-- Floating Card 1: FirmsLedger -->
        <a
          href="#projects"
          class="hero-float-card absolute top-2 left-0 sm:left-4 w-60 sm:w-72 rounded-2xl overflow-hidden border border-border shadow-2xl bg-white hover:scale-105 transition-all duration-500 z-20 group"
          data-speed="0.04"
        >
          <div class="px-3 py-2 bg-surface-alt border-b border-border flex items-center justify-between">
            <span class="text-[10px] font-bold uppercase tracking-wider text-text-primary font-display">FirmsLedger</span>
            <span class="text-[9px] font-mono text-emerald-600 bg-emerald-50 px-2 py-0.5 rounded-full border border-emerald-200">Live</span>
          </div>
          <div class="aspect-[16/10] overflow-hidden bg-slate-900">
            <img src="/projects/firmsledger/landing.png" alt="FirmsLedger preview" class="w-full h-full object-cover object-top group-hover:scale-105 transition-transform duration-500" />
          </div>
        </a>

        <!-- Floating Card 2: Betorra -->
        <a
          href="#projects"
          class="hero-float-card absolute top-28 right-0 sm:right-2 w-56 sm:w-64 rounded-2xl overflow-hidden border border-border shadow-2xl bg-slate-900 hover:scale-105 transition-all duration-500 z-30 group"
          data-speed="-0.03"
        >
          <div class="px-3 py-2 bg-slate-800 border-b border-slate-700 flex items-center justify-between">
            <span class="text-[10px] font-bold uppercase tracking-wider text-white font-display">Betorra Platform</span>
            <span class="text-[9px] font-mono text-slate-300">Backend</span>
          </div>
          <div class="aspect-[16/10] overflow-hidden">
            <img src="/projects/betorra/dashboard.png" alt="Betorra preview" class="w-full h-full object-cover object-top group-hover:scale-105 transition-transform duration-500" />
          </div>
        </a>

        <!-- Floating Card 3: HMD SaaS -->
        <a
          href="#projects"
          class="hero-float-card absolute bottom-2 left-6 sm:left-10 w-52 sm:w-60 rounded-2xl overflow-hidden border border-border shadow-xl bg-white hover:scale-105 transition-all duration-500 z-10 group"
          data-speed="0.02"
        >
          <div class="px-3 py-2 bg-surface-alt border-b border-border flex items-center justify-between">
            <span class="text-[10px] font-bold uppercase tracking-wider text-text-primary font-display">HMD Medical</span>
            <span class="text-[9px] font-mono text-emerald-600 bg-emerald-50 px-2 py-0.5 rounded-full border border-emerald-200">SaaS</span>
          </div>
          <div class="aspect-[16/10] overflow-hidden">
            <img src="/projects/hmd/hmd-5.png" alt="HMD Medical preview" class="w-full h-full object-cover object-top group-hover:scale-105 transition-transform duration-500" />
          </div>
        </a>
      </div>

    </div>
  </div>

  <!-- Integrated Stats Bar -->
  <div class="mx-auto max-w-7xl px-6 sm:px-8 lg:px-12 w-full pt-8 border-t border-border relative z-10">
    <div class="grid grid-cols-3 gap-6 sm:gap-12">
      <div>
        <span class="text-xl sm:text-2xl font-black text-text-primary font-display block tracking-tight">01+</span>
        <span class="text-xs text-text-tertiary font-medium">Years building production software</span>
      </div>
      <div>
        <span class="text-xl sm:text-2xl font-black text-text-primary font-display block tracking-tight">11+</span>
        <span class="text-xs text-text-tertiary font-medium">Projects shipped</span>
      </div>
      <div>
        <span class="text-xl sm:text-2xl font-black text-text-primary font-display block tracking-tight">1,200+</span>
        <span class="text-xs text-text-tertiary font-medium">Games integrated</span>
      </div>
    </div>
  </div>
</section>

<!-- Mouse Parallax Interaction Script -->
<script>
  document.addEventListener("DOMContentLoaded", () => {
    const heroSection = document.getElementById("hero-section");
    const floatCards = document.querySelectorAll(".hero-float-card");

    if (!heroSection || !floatCards.length) return;

    heroSection.addEventListener("mousemove", (e: MouseEvent) => {
      const { clientX, clientY } = e;
      const centerX = window.innerWidth / 2;
      const centerY = window.innerHeight / 2;

      const deltaX = (clientX - centerX);
      const deltaY = (clientY - centerY);

      floatCards.forEach((card) => {
        const speed = parseFloat((card as HTMLElement).dataset.speed || "0.02");
        const x = deltaX * speed;
        const y = deltaY * speed;

        (card as HTMLElement).style.transform = `translate3d(${x}px, ${y}px, 0)`;
      });
    });

    heroSection.addEventListener("mouseleave", () => {
      floatCards.forEach((card) => {
        (card as HTMLElement).style.transform = `translate3d(0px, 0px, 0)`;
      });
    });
  });
</script>
