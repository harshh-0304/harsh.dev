---
import SectionHeading from "./SectionHeading.astro";
import { skills } from "@/config/site";
---

<section id="skills" class="py-16 lg:py-20">
  <div class="mx-auto max-w-6xl px-6">
    <SectionHeading
      label="Skills"
      title="Technologies I work with"
      description="Focused on backend engineering with production experience across these technologies."
    />

    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6 stagger">
      {
        Object.entries(skills).map(([category, items]) => (
          <div class="fade-up neo-card rounded-2xl bg-white p-6">
            <h3 class="text-sm font-semibold text-text-primary mb-4 uppercase tracking-wide">{category}</h3>
            <div class="flex flex-wrap gap-2">
              {items.map((skill) => (
                <span class="text-sm font-medium text-text-primary bg-white border-2 border-text-primary rounded-lg px-3 py-1.5 hover:bg-brand hover:text-white transition-all duration-200">
                  {skill}
                </span>
              ))}
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
