---
interface Props {
  label: string;
  title: string;
  description?: string;
}

const { label, title, description } = Astro.props;
---

<div class="fade-up mb-10 lg:mb-12">
  <p class="text-xs font-bold uppercase tracking-widest text-brand mb-2">{label}</p>
  <h2 class="text-3xl sm:text-4xl font-black tracking-tight text-text-primary mb-3 uppercase font-display leading-tight">{title}</h2>
  {description && <p class="text-sm text-text-secondary max-w-2xl leading-relaxed">{description}</p>}
</div>
