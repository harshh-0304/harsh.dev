---
import { site, education } from "@/config/site";
const edu = education[0];
---

<section id="about" class="py-24 lg:py-32 bg-surface border-t border-border">
  <div class="mx-auto max-w-7xl px-6 sm:px-8 lg:px-12">
    <!-- Header eyebrow -->
    <div class="mb-12" data-reveal="fade-up">
      <p class="text-xs font-bold uppercase tracking-widest text-text-tertiary">
        About & Background
      </p>
    </div>

    <div class="grid lg:grid-cols-12 gap-8 lg:gap-12 items-stretch">

      <!-- Left Column: Unified Structured Profile Card (5 cols) -->
      <div class="lg:col-span-5 flex flex-col" data-reveal="fade-up">
        <div class="rounded-3xl border border-border bg-surface-alt p-6 sm:p-8 flex flex-col justify-between h-full shadow-sm hover:shadow-md transition-all">
          <!-- Portrait Avatar Frame -->
          <div>
            <div class="relative w-full aspect-[4/3] rounded-2xl overflow-hidden border border-border/80 shadow-md mb-8 group">
              <img
                src={site.avatar}
                alt={site.name}
                width="400"
                height="300"
                class="w-full h-full object-cover object-center group-hover:scale-105 transition-transform duration-500"
                loading="lazy"
              />
            </div>

            <!-- Quick Background Details List -->
            <div class="space-y-1">
              <p class="text-xs font-bold uppercase tracking-widest text-text-tertiary mb-3">Quick Facts</p>
              
              <div class="flex flex-col sm:flex-row sm:items-center justify-between py-3 border-b border-border/80 gap-1 sm:gap-4">
                <span class="text-xs font-medium text-text-tertiary uppercase tracking-wider">Current Role</span>
                <span class="text-sm font-semibold text-text-primary sm:text-right">Software Engineer @ Amex Technology</span>
              </div>
              <div class="flex flex-col sm:flex-row sm:items-center justify-between py-3 border-b border-border/80 gap-1 sm:gap-4">
                <span class="text-xs font-medium text-text-tertiary uppercase tracking-wider">Experience</span>
                <span class="text-sm font-semibold text-text-primary sm:text-right">1.5+ Years Production</span>
              </div>
              <div class="flex flex-col sm:flex-row sm:items-center justify-between py-3 border-b border-border/80 gap-1 sm:gap-4">
                <span class="text-xs font-medium text-text-tertiary uppercase tracking-wider">Location</span>
                <span class="text-sm font-semibold text-text-primary sm:text-right">{site.location}</span>
              </div>
              <div class="flex flex-col sm:flex-row sm:items-center justify-between py-3 border-b border-border/80 gap-1 sm:gap-4">
                <span class="text-xs font-medium text-text-tertiary uppercase tracking-wider">Degree</span>
                <span class="text-sm font-semibold text-text-primary sm:text-right">{edu.degree} ({edu.cgpa})</span>
              </div>
              <div class="flex flex-col sm:flex-row sm:items-center justify-between py-3 gap-1 sm:gap-4">
                <span class="text-xs font-medium text-text-tertiary uppercase tracking-wider">Institution</span>
                <span class="text-sm font-semibold text-text-primary sm:text-right">{edu.institution}</span>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Right Column: Narrative & Education Callout Card (7 cols) -->
      <div class="lg:col-span-7 flex flex-col justify-between space-y-8" data-reveal="fade-up" data-reveal-delay="150">
        <div>
          <h2 class="text-3xl sm:text-4xl lg:text-5xl font-black text-text-primary tracking-tight leading-[1.08] font-display mb-8">
            Software Engineer focused on reliability, performance, and clean product execution.
          </h2>

          <div class="space-y-5 text-base text-text-secondary leading-relaxed border-t border-border pt-8">
            <p>
              I'm Harsh — a software engineer based in Ahmedabad, India. I architect and ship production digital products end-to-end: from high-concurrency database schemas and edge serverless APIs to intuitive frontend user experiences.
            </p>
            <p>
              At <strong class="text-text-primary font-semibold">Amex Technology</strong>, I engineer platforms like <strong class="text-text-primary font-semibold">FirmsLedger</strong> (a 10,000+ US manufacturers directory running on Cloudflare Workers and Neon Postgres with automated dual-model NVIDIA Nemotron AI fact-checking) and <strong class="text-text-primary font-semibold">GoSwiftFund</strong> (a fintech small-business funding marketplace with Plaid bank verification and AES-256-GCM encryption).
            </p>
            <p>
              I also engineer <strong class="text-text-primary font-semibold">SimpleT</strong>, an enterprise SaaS platform integrating with the Salesforce Metadata API and Celery job queues to translate global enterprise orgs (hardened under ISO/IEC 27001:2022 ISMS, SOC 2, and GDPR audit standards), and previously architected backend infrastructure integrating 1,200+ games at an <strong class="text-text-primary font-semibold">iGaming platform</strong>.
            </p>
          </div>
        </div>

        <!-- Aligned Academic Callout Card -->
        <div class="rounded-2xl border border-border bg-surface-alt p-6 flex flex-col sm:flex-row sm:items-center justify-between gap-6 shadow-sm">
          <div>
            <p class="text-xs font-bold uppercase tracking-widest text-text-tertiary mb-1">Academic Foundation</p>
            <p class="text-sm font-bold text-text-primary">{edu.degree} — {edu.institution}</p>
            <p class="text-xs text-text-tertiary font-mono mt-0.5">{edu.period} · CGPA: {edu.cgpa}</p>
          </div>
          <a
            href="#contact"
            class="inline-flex items-center justify-center gap-2 rounded-full bg-text-primary px-6 py-3 text-xs font-bold uppercase tracking-wider text-white hover:bg-black transition-colors shrink-0"
          >
            Get in touch &rarr;
          </a>
        </div>
      </div>

    </div>
  </div>
</section>
