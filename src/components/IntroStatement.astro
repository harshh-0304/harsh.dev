---
const statement = "I like turning complicated engineering problems into simple, reliable digital products.";
const words = statement.split(" ");
---

<section id="intro-statement" class="py-24 lg:py-32 border-y border-border/80 bg-surface">
  <div class="mx-auto max-w-7xl px-6 sm:px-8 lg:px-12">
    <p class="text-xs font-semibold uppercase tracking-widest text-text-tertiary mb-8" data-reveal="fade-up">
      Philosophy
    </p>

    <!-- Large Editorial Statement with Word-by-Word Scroll Reveal -->
    <h2 class="text-3xl sm:text-5xl lg:text-6xl font-bold tracking-tight leading-[1.15] text-text-primary max-w-5xl">
      {words.map((word, index) => (
        <span class="reveal-word inline-block mr-[0.25em]" key={index}>
          {word}
        </span>
      ))}
    </h2>

    <div class="mt-12 flex flex-col sm:flex-row sm:items-center gap-4 sm:gap-6 text-sm text-text-secondary font-medium" data-reveal="fade-up" data-reveal-delay="200">
      <span>Currently: <strong class="text-text-primary">Software Engineer at Betorra</strong></span>
      <span class="hidden sm:block w-1.5 h-1.5 rounded-full bg-border"></span>
      <span>Previously: <strong class="text-text-primary">DubFlix</strong> · <strong class="text-text-primary">Grownited</strong></span>
    </div>
  </div>
</section>
