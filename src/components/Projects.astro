---
import SectionHeading from "./SectionHeading.astro";
import { getCollection } from "astro:content";

const allProjects = (await getCollection("projects")).sort(
  (a, b) => a.data.order - b.data.order
);

// Top 4 Featured Client/Primary Projects
const featured = allProjects.filter(p => p.data.featured && p.data.professional);
// Remaining projects for clean text directory
const secondary = allProjects.filter(p => !featured.includes(p));
---

<section id="projects" class="py-24 lg:py-32 bg-surface relative">
  <div class="mx-auto max-w-7xl px-6 sm:px-8 lg:px-12">
    <!-- Header -->
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-20">
      <div>
        <p class="text-xs font-semibold uppercase tracking-widest text-text-tertiary mb-3" data-reveal="fade-up">
          Featured Work
        </p>
        <h2 class="text-4xl sm:text-5xl font-extrabold tracking-tight text-text-primary uppercase" data-reveal="fade-up" data-reveal-delay="100">
          Selected Projects
        </h2>
      </div>
      <p class="text-sm text-text-secondary max-w-sm" data-reveal="fade-up" data-reveal-delay="200">
        Production systems, high-concurrency platforms, and client products delivered with precision.
      </p>
    </div>

    <!-- Editorial Showcase Entries -->
    <div class="space-y-28 lg:space-y-36">
      {featured.map((project, index) => {
        const projectNum = `0${index + 1}`;
        const hasScreenshots = project.data.screenshots && project.data.screenshots.length > 0;
        const mainImage = project.data.image || (hasScreenshots ? project.data.screenshots[0] : null);

        const targetUrl = project.data.url || project.data.github || project.data.buttons?.find(b => b.url)?.url || (project.data.professional ? `/projects/${project.id}` : undefined);
        const isExternal = targetUrl?.startsWith("http");

        return (
          <div key={project.data.title} class="group border-t border-border pt-12 lg:pt-16">
            <!-- Project Row -->
            <div class="grid lg:grid-cols-12 gap-8 lg:gap-12 items-start">
              <!-- Left Metadata & Content (5 cols) -->
              <div class="lg:col-span-5 flex flex-col justify-between h-full space-y-6">
                <div>
                  <div class="flex items-center justify-between mb-4">
                    <span class="text-3xl font-extrabold text-brand tracking-tighter">{projectNum}</span>
                    <span class="text-xs font-semibold uppercase tracking-wider text-emerald-700 bg-emerald-50 px-3 py-1 rounded-full border border-emerald-200">
                      {project.data.status}
                    </span>
                  </div>

                  <h3 class="text-3xl sm:text-4xl font-extrabold text-text-primary tracking-tight mb-3 group-hover:text-brand transition-colors duration-300">
                    {targetUrl ? (
                      <a href={targetUrl} target={isExternal ? "_blank" : "_self"} rel={isExternal ? "noopener noreferrer" : ""} class="hover:underline">
                        {project.data.title}
                      </a>
                    ) : (
                      project.data.title
                    )}
                  </h3>
                  <p class="text-xs font-semibold uppercase tracking-wider text-text-tertiary mb-6">
                    {project.data.category}
                  </p>

                  <p class="text-base text-text-secondary leading-relaxed mb-6">
                    {project.data.description}
                  </p>

                  {/* Tech stack */}
                  <div class="flex flex-wrap gap-2 mb-8">
                    {project.data.tech.map((t: string) => (
                      <span key={t} class="text-xs font-medium text-text-secondary bg-surface-alt border border-border px-3 py-1 rounded-md">
                        {t}
                      </span>
                    ))}
                  </div>
                </div>

                <!-- CTAs -->
                <div class="flex flex-wrap gap-4 pt-4 border-t border-border/60">
                  {project.data.url && (
                    <a
                      href={project.data.url}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="inline-flex items-center gap-2 text-sm font-semibold text-text-primary hover:text-brand transition-colors"
                    >
                      Live Product
                      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 3h6v6"/><path d="M10 14 21 3"/><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/></svg>
                    </a>
                  )}
                  {project.data.github && (
                    <a
                      href={project.data.github}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="inline-flex items-center gap-2 text-sm font-semibold text-text-secondary hover:text-text-primary transition-colors"
                    >
                      GitHub &rarr;
                    </a>
                  )}
                  {project.data.buttons?.map(btn => (
                    btn.url && (
                      <a
                        key={btn.label}
                        href={btn.url}
                        target={btn.url.startsWith("http") ? "_blank" : "_self"}
                        rel={btn.url.startsWith("http") ? "noopener noreferrer" : ""}
                        class="inline-flex items-center gap-2 text-sm font-semibold text-text-secondary hover:text-text-primary transition-colors"
                      >
                        {btn.label} &rarr;
                      </a>
                    )
                  ))}
                </div>
              </div>

              <!-- Right Image Showcase (7 cols) -->
              <div class="lg:col-span-7">
                {targetUrl ? (
                  <a
                    href={targetUrl}
                    target={isExternal ? "_blank" : "_self"}
                    rel={isExternal ? "noopener noreferrer" : ""}
                    class="block rounded-2xl border border-border shadow-lg overflow-hidden transition-all duration-300 hover:border-brand/50 hover:shadow-2xl group/img cursor-pointer focus:outline-none focus:ring-2 focus:ring-brand/40"
                    title={`Open ${project.data.title}`}
                  >
                    {project.data.category === "iOS Mobile Application" && hasScreenshots ? (
                      <div class="bg-surface-alt p-6 lg:p-8 flex justify-center items-center gap-4 overflow-hidden">
                        {project.data.screenshots!.slice(0, 3).map((src: string, idx: number) => (
                          <div key={src} class={`relative rounded-xl overflow-hidden shadow-xl border border-gray-200 h-64 sm:h-80 w-auto transition-transform duration-500 group-hover/img:scale-105 ${idx === 1 ? "scale-105 z-10" : "scale-95 opacity-90"}`}>
                            <img src={src} alt={`${project.data.title} screenshot ${idx+1}`} class="h-full w-auto object-contain" loading="lazy" />
                          </div>
                        ))}
                      </div>
                    ) : mainImage ? (
                      <div class="project-img-container bg-slate-950 aspect-[16/10]">
                        <img
                          src={mainImage}
                          alt={`${project.data.title} visual`}
                          class="w-full h-full object-cover object-center transition-transform duration-700 ease-out group-hover/img:scale-105"
                          loading="lazy"
                        />
                      </div>
                    ) : (
                      <div class="bg-surface-alt p-8 aspect-[16/10] flex flex-col justify-center">
                        <p class="text-xs uppercase tracking-wider text-text-tertiary mb-2 font-semibold">Architectural Highlight</p>
                        <p class="text-base text-text-secondary leading-relaxed">{project.data.problem}</p>
                      </div>
                    )}
                  </a>
                ) : (
                  <div class="rounded-2xl border border-border shadow-lg overflow-hidden">
                    {project.data.category === "iOS Mobile Application" && hasScreenshots ? (
                      <div class="bg-surface-alt p-6 lg:p-8 flex justify-center items-center gap-4 overflow-hidden">
                        {project.data.screenshots!.slice(0, 3).map((src: string, idx: number) => (
                          <div key={src} class={`relative rounded-xl overflow-hidden shadow-xl border border-gray-200 h-64 sm:h-80 w-auto transition-transform duration-500 ${idx === 1 ? "scale-105 z-10" : "scale-95 opacity-90"}`}>
                            <img src={src} alt={`${project.data.title} screenshot ${idx+1}`} class="h-full w-auto object-contain" loading="lazy" />
                          </div>
                        ))}
                      </div>
                    ) : mainImage ? (
                      <div class="project-img-container bg-slate-950 aspect-[16/10]">
                        <img
                          src={mainImage}
                          alt={`${project.data.title} visual`}
                          class="w-full h-full object-cover object-center"
                          loading="lazy"
                        />
                      </div>
                    ) : (
                      <div class="bg-surface-alt p-8 aspect-[16/10] flex flex-col justify-center">
                        <p class="text-xs uppercase tracking-wider text-text-tertiary mb-2 font-semibold">Architectural Highlight</p>
                        <p class="text-base text-text-secondary leading-relaxed">{project.data.problem}</p>
                      </div>
                    )}
                  </div>
                )}
              </div>
            </div>
          </div>
        );
      })}
    </div>

    <!-- Secondary Projects Directory -->
    {secondary.length > 0 && (
      <div class="mt-32 border-t border-border pt-16">
        <div class="flex items-center justify-between mb-8">
          <h3 class="text-xs font-semibold uppercase tracking-widest text-text-tertiary">
            Additional Projects & Systems
          </h3>
          <span class="text-xs text-text-tertiary font-mono">{secondary.length} Projects</span>
        </div>

        <div class="divide-y divide-border border-b border-border">
          {secondary.map((proj) => (
            <div key={proj.data.title} class="py-5 flex flex-col sm:flex-row sm:items-center justify-between gap-4 group hover:bg-surface-alt/50 px-3 rounded-lg transition-colors duration-200">
              <div class="flex flex-col sm:flex-row sm:items-center gap-1.5 sm:gap-4">
                <span class="text-sm font-bold text-text-primary group-hover:text-brand transition-colors">
                  {proj.data.title}
                </span>
                <span class="text-xs text-text-tertiary bg-surface-alt border border-border px-2.5 py-0.5 rounded-full w-fit">
                  {proj.data.category}
                </span>
              </div>

              <div class="flex items-center gap-6">
                <span class="text-xs text-text-secondary hidden md:inline font-mono">
                  {proj.data.tech.slice(0, 3).join(" · ")}
                </span>
                {proj.data.url ? (
                  <a href={proj.data.url} target="_blank" rel="noopener noreferrer" class="text-xs font-semibold text-brand hover:text-brand-dark transition-colors">
                    Visit &rarr;
                  </a>
                ) : proj.data.github ? (
                  <a href={proj.data.github} target="_blank" rel="noopener noreferrer" class="text-xs font-semibold text-text-secondary hover:text-text-primary transition-colors">
                    Source &rarr;
                  </a>
                ) : (
                  <span class="text-xs text-text-tertiary">{proj.data.status}</span>
                )}
              </div>
            </div>
          ))}
        </div>
      </div>
    )}
  </div>
</section>
