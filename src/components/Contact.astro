---
import { site } from "@/config/site";
---

<section id="contact" class="py-24 lg:py-36 bg-surface border-t border-border relative overflow-hidden">
  <div class="mx-auto max-w-7xl px-6 sm:px-8 lg:px-12 relative">
    <div class="grid lg:grid-cols-12 gap-12 lg:gap-16 items-start">

      <!-- Left Column: Editorial Statement (5 cols) -->
      <div class="lg:col-span-5 space-y-6" data-reveal="fade-up">
        <p class="text-xs font-semibold uppercase tracking-widest text-text-tertiary">
          Contact
        </p>
        <h2 class="text-4xl sm:text-5xl font-extrabold tracking-tight leading-[1.05] text-text-primary uppercase">
          Have something worth building?
        </h2>
        <p class="text-xl font-medium text-brand">
          Let's talk &rarr;
        </p>
        <p class="text-sm text-text-secondary leading-relaxed pt-2">
          Whether you need a full-stack web app, high-concurrency API infrastructure, or intelligent AI integrations — I'd love to discuss how I can help.
        </p>

        <!-- Direct links -->
        <div class="pt-6 border-t border-border space-y-3 text-sm">
          <p class="text-xs font-semibold uppercase tracking-wider text-text-tertiary">Direct Reach</p>
          <div class="flex flex-col gap-2">
            <a href={`mailto:${site.email}`} class="text-text-primary font-medium hover:text-brand transition-colors inline-flex items-center gap-2">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
              {site.email}
            </a>
            <a href={site.linkedin} target="_blank" rel="noopener noreferrer" class="text-text-secondary font-medium hover:text-brand transition-colors inline-flex items-center gap-2">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/><rect width="4" height="12" x="2" y="9"/><circle cx="4" cy="4" r="2"/></svg>
              LinkedIn Profile
            </a>
            <a href={site.github} target="_blank" rel="noopener noreferrer" class="text-text-secondary font-medium hover:text-brand transition-colors inline-flex items-center gap-2">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"/><path d="M9 18c-4.51 2-5-2-7-2"/></svg>
              GitHub / harshh-0304
            </a>
          </div>
        </div>
      </div>

      <!-- Right Column: Form (7 cols) -->
      <div class="lg:col-span-7" data-reveal="fade-up" data-reveal-delay="150">
        <form
          action="https://api.web3forms.com/submit"
          method="POST"
          class="space-y-5 bg-surface-alt p-8 sm:p-10 rounded-2xl border border-border"
          id="contact-form"
        >
          <input type="hidden" name="access_key" value="13179078-8114-46b7-a4c5-4ac3689d1639" />
          <input type="hidden" name="subject" value="New message from portfolio" />
          <input type="hidden" name="from_name" value="Portfolio Contact Form" />
          <input type="hidden" name="redirect" value="https://web3forms.com/success" />

          <div class="grid sm:grid-cols-2 gap-4">
            <div>
              <label for="name" class="block text-xs font-semibold uppercase tracking-wider text-text-secondary mb-2">Your Name</label>
              <input
                type="text"
                name="name"
                id="name"
                required
                placeholder="Alex Smith"
                class="w-full rounded-xl border border-border bg-white px-4 py-3 text-sm text-text-primary placeholder:text-text-tertiary focus:outline-none focus:border-brand transition-colors"
              />
            </div>
            <div>
              <label for="email" class="block text-xs font-semibold uppercase tracking-wider text-text-secondary mb-2">Email Address</label>
              <input
                type="email"
                name="email"
                id="email"
                required
                placeholder="alex@company.com"
                class="w-full rounded-xl border border-border bg-white px-4 py-3 text-sm text-text-primary placeholder:text-text-tertiary focus:outline-none focus:border-brand transition-colors"
              />
            </div>
          </div>

          <div>
            <label for="message" class="block text-xs font-semibold uppercase tracking-wider text-text-secondary mb-2">Project Details</label>
            <textarea
              name="message"
              id="message"
              required
              rows="5"
              placeholder="Tell me about your project, timeline, or open role..."
              class="w-full rounded-xl border border-border bg-white px-4 py-3 text-sm text-text-primary placeholder:text-text-tertiary focus:outline-none focus:border-brand transition-colors resize-none"
            ></textarea>
          </div>

          <button
            type="submit"
            class="w-full sm:w-auto inline-flex items-center justify-center gap-2 rounded-full bg-text-primary px-8 py-3.5 text-sm font-semibold text-white shadow-lg hover:bg-brand hover:shadow-brand/20 transition-all duration-300 cursor-pointer"
          >
            Send Message &rarr;
          </button>
        </form>
      </div>

    </div>
  </div>
</section>
