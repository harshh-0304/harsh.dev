---
import { getCollection } from "astro:content";

const experiences = (await getCollection("experience")).sort(
  (a, b) => a.data.order - b.data.order
);
---

<section id="experience" class="py-24 lg:py-32 bg-surface-alt border-t border-border">
  <div class="mx-auto max-w-7xl px-6 sm:px-8 lg:px-12">
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-20">
      <div>
        <p class="text-xs font-semibold uppercase tracking-widest text-text-tertiary mb-3" data-reveal="fade-up">
          Track Record
        </p>
        <h2 class="text-4xl sm:text-5xl font-extrabold tracking-tight text-text-primary uppercase" data-reveal="fade-up" data-reveal-delay="100">
          Professional Experience
        </h2>
      </div>
      <p class="text-sm text-text-secondary max-w-sm" data-reveal="fade-up" data-reveal-delay="200">
        Production-level engineering across backend infrastructure, AI workflows, and software development.
      </p>
    </div>

    <!-- Editorial Horizontal Split Timeline -->
    <div class="divide-y divide-border border-y border-border">
      {experiences.map((exp, i) => (
        <div key={exp.data.company} class="py-12 grid lg:grid-cols-12 gap-8 items-start group" data-reveal="fade-up" data-reveal-delay={i * 100}>
          <!-- Left: Period & Status (4 cols) -->
          <div class="lg:col-span-4 flex flex-col justify-between">
            <div class="flex items-center gap-3 mb-2">
              {i === 0 && (
                <span class="inline-flex items-center gap-1.5 text-xs font-semibold uppercase tracking-wider text-emerald-800 bg-emerald-50 px-2.5 py-0.5 rounded-full border border-emerald-200">
                  <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
                  Current Role
                </span>
              )}
              <span class="text-xs font-semibold text-text-tertiary uppercase tracking-wider">{exp.data.type}</span>
            </div>
            <p class="text-sm font-semibold text-text-tertiary font-mono">{exp.data.period}</p>
          </div>

          <!-- Right: Role, Company & Bullet points (8 cols) -->
          <div class="lg:col-span-8">
            <h3 class="text-2xl font-bold text-text-primary mb-1 group-hover:text-brand transition-colors duration-300">
              {exp.data.title}
            </h3>

            <div class="mb-4">
              {exp.data.url ? (
                <a
                  href={exp.data.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-sm font-semibold text-brand hover:text-brand-dark transition-colors inline-flex items-center gap-1"
                >
                  {exp.data.company}
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><path d="M15 3h6v6"/><path d="M10 14 21 3"/></svg>
                </a>
              ) : (
                <span class="text-sm font-semibold text-text-secondary">{exp.data.company}</span>
              )}
            </div>

            <!-- Body details -->
            <div class="text-sm text-text-secondary leading-relaxed mb-6 [&_li]:mb-2 [&_ul]:list-disc [&_ul]:pl-4 [&_strong]:text-text-primary [&_strong]:font-semibold">
              <Fragment set:html={exp.rendered?.html || ""} />
            </div>

            <!-- Tech line -->
            <p class="text-xs text-text-tertiary font-mono">
              <span class="text-text-secondary font-semibold">Tech:</span> {exp.data.tech.join(" · ")}
            </p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
