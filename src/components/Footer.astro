---
import { site, navigation } from "@/config/site";
---

<footer class="border-t border-border bg-surface py-12">
  <div class="mx-auto max-w-7xl px-6 sm:px-8 lg:px-12">
    <div class="flex flex-col sm:flex-row justify-between items-center gap-6">
      <div>
        <a href="/" class="text-base font-bold tracking-tight text-text-primary uppercase">
          {site.name}<span class="text-brand">.</span>
        </a>
        <span class="text-xs text-text-tertiary ml-3">Software Engineer</span>
      </div>

      <div class="flex flex-wrap justify-center items-center gap-x-6 gap-y-2 text-xs font-semibold uppercase tracking-wider text-text-tertiary">
        {navigation.map((item) => (
          <a key={item.label} href={item.href} class="hover:text-text-primary transition-colors">
            {item.label}
          </a>
        ))}
      </div>

      <p class="text-xs text-text-tertiary">
        &copy; {new Date().getFullYear()} {site.name}. All rights reserved.
      </p>
    </div>
  </div>
</footer>
