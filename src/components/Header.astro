---
import { site, navigation } from "@/config/site";
---

<header
  id="header"
  class="fixed top-0 left-0 right-0 z-50 transition-all duration-300 backdrop-blur-md bg-white/80 border-b border-border/40 shadow-xs"
>
  <nav class="mx-auto max-w-7xl px-6 sm:px-8 lg:px-12 py-3.5 flex items-center justify-between">
    <!-- Logo -->
    <a href="/" class="text-lg font-black tracking-tight text-text-primary font-display flex items-center gap-1">
      {site.name}<span class="text-brand">.</span>
    </a>

    <!-- Desktop Navigation -->
    <div class="hidden md:flex items-center gap-7">
      {
        navigation.map((item) => (
          <a
            href={item.href}
            data-nav-href={item.href}
            class="nav-link text-sm font-medium text-text-secondary hover:text-text-primary transition-colors py-1 relative"
          >
            {item.label}
          </a>
        ))
      }

      <!-- Resume Button in Navbar -->
      <a
        href={site.resumeUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-1.5 rounded-full border border-border bg-white px-3.5 py-1.5 text-xs font-semibold text-text-primary shadow-2xs hover:border-slate-900 hover:bg-surface-alt transition-all"
      >
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
          <polyline points="7 10 12 15 17 10"></polyline>
          <line x1="12" y1="15" x2="12" y2="3"></line>
        </svg>
        Resume
      </a>

      <!-- Contact Button -->
      <a
        href="#contact"
        class="inline-flex items-center gap-1.5 rounded-full bg-slate-900 px-4 py-1.5 text-xs font-bold uppercase tracking-wider text-white shadow-xs hover:bg-black transition-all"
      >
        Get in touch &rarr;
      </a>
    </div>

    <!-- Mobile Menu Button -->
    <button
      id="mobile-menu-btn"
      class="md:hidden p-2 -mr-2 text-text-secondary hover:text-text-primary"
      aria-label="Toggle menu"
    >
      <svg
        width="24"
        height="24"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <line x1="3" y1="6" x2="21" y2="6"></line>
        <line x1="3" y1="12" x2="21" y2="12"></line>
        <line x1="3" y1="18" x2="21" y2="18"></line>
      </svg>
    </button>
  </nav>

  <!-- Mobile Menu -->
  <div
    id="mobile-menu"
    class="hidden md:hidden border-t border-border/60 bg-white/98 backdrop-blur-lg shadow-lg transition-all"
  >
    <div class="px-6 py-4 flex flex-col gap-3">
      {
        navigation.map((item) => (
          <a
            href={item.href}
            class="mobile-nav-link text-base font-medium text-text-secondary hover:text-brand py-2 transition-colors flex items-center justify-between"
          >
            <span>{item.label}</span>
            <span class="text-xs text-text-muted">&rarr;</span>
          </a>
        ))
      }
      <a
        href={site.resumeUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="mobile-nav-link inline-flex items-center justify-between py-2 text-base font-medium text-text-secondary hover:text-brand"
      >
        <span>Download Resume / CV</span>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
          <polyline points="7 10 12 15 17 10"></polyline>
          <line x1="12" y1="15" x2="12" y2="3"></line>
        </svg>
      </a>
      <a
        href="#contact"
        class="mobile-nav-link mt-2 inline-flex items-center justify-center rounded-lg bg-brand px-4 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-brand/90 transition-all"
      >
        Get in touch
      </a>
    </div>
  </div>
</header>

<script>
  // Mobile menu toggle
  const btn = document.getElementById("mobile-menu-btn");
  const menu = document.getElementById("mobile-menu");
  btn?.addEventListener("click", () => menu?.classList.toggle("hidden"));

  document.querySelectorAll(".mobile-nav-link").forEach((link) => {
    link.addEventListener("click", () => menu?.classList.add("hidden"));
  });

  // Header background transition on scroll
  const header = document.getElementById("header");
  const onScroll = () => {
    header?.classList.toggle("shadow-sm", window.scrollY > 20);
    header?.classList.toggle("bg-white/95", window.scrollY > 20);
    header?.classList.toggle("bg-white/80", window.scrollY <= 20);
  };
  window.addEventListener("scroll", onScroll, { passive: true });
  onScroll();

  // DSA: O(1) Hash Map for active scroll-spy state tracking
  const navMap = new Map<string, HTMLAnchorElement>();
  document.querySelectorAll<HTMLAnchorElement>(".nav-link").forEach((link) => {
    const id = link.dataset.navHref?.replace("#", "");
    if (id) navMap.set(id, link);
  });

  let activeLink: HTMLAnchorElement | null = null;

  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          const next = navMap.get(entry.target.id);
          if (next && next !== activeLink) {
            activeLink?.classList.remove("text-slate-950", "font-bold");
            activeLink?.classList.add("text-text-secondary");

            next.classList.remove("text-text-secondary");
            next.classList.add("text-slate-950", "font-bold");
            activeLink = next;
          }
        }
      });
    },
    { rootMargin: "-30% 0px -60% 0px" }
  );

  document.querySelectorAll("section[id]").forEach((el) => observer.observe(el));
</script>
