---
import { trustedTech } from "@/config/site";
---

<section class="py-14 border-y-4 border-text-primary bg-surface-alt">
  <div class="mx-auto max-w-6xl px-6">
    <p class="text-center text-xs text-text-secondary mb-8 tracking-widest uppercase font-bold">
      Trusted Technologies
    </p>
    <div class="flex flex-wrap justify-center gap-x-8 gap-y-3">
      {
        trustedTech.map((tech) => (
          <span class="text-base font-bold text-text-primary hover:text-brand transition-colors duration-200 cursor-default">
            {tech}
          </span>
        ))
      }
    </div>
  </div>
</section>
